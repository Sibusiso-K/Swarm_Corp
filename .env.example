# Copy this file to .env and paste your keys in — never commit .env itself.
# Only GROQ_API_KEY is required. Every other provider is optional and just
# widens the model pool. verify_key.py does a REAL completion call, so a
# provider whose key is set but whose account can't serve is caught there.

# --- Required ---
# Groq (free, 6K–12K TPM). https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional: verified working on a free/no-card tier ---
# OpenRouter (aggregator, 18+ :free models). https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Mistral (includes codestral). https://console.mistral.ai/
MISTRAL_API_KEY=
# NVIDIA NIM (only some models serve per account). https://build.nvidia.com/
NVIDIA_API_KEY=
# Google AI Studio (15 RPM / 1500 RPD). https://ai.google.dev/
GEMINI_API_KEY=
# HuggingFace Inference Providers. https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# SiliconFlow. https://siliconflow.com/
SILICONFLOW_API_KEY=
# Cohere (OpenAI-compat endpoint). https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Baseten. https://app.baseten.co/
BASETEN_API_KEY=

# --- Optional: local, no key needed ---
# Ollama (--private mode). Install at https://ollama.ai, runs on :11434.
# Then: ollama pull qwen2.5-coder:3b

# --- Known NOT to serve on a free tier (left here so you know why) ---
# Cerebras: 402 payment_required   SambaNova: 402 zero balance
# GitHub Models: retired (410)     Fireworks: 412 account not ready
