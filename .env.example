# Copy this file to .env and paste your keys in — never commit .env itself.

# Groq (free, up to 6K-12K TPM)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras (free, up to 60K TPM — best for Coder role)
# Get a key at https://console.cerebras.ai/
CEREBRAS_API_KEY=

# NVIDIA NIM (free, 40 RPM credit-based)
# Get a key at https://build.nvidia.com/
NVIDIA_API_KEY=

# Google AI Studio (free, 15 RPM / 1500 RPD)
# Get a key at https://ai.google.dev/
GEMINI_API_KEY=

# Ollama (Phase 5: local private models)
# Install at https://ollama.ai, runs on localhost:11434 — no API key needed
